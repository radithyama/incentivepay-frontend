VITE_API_BASE_URL=http://localhost:8080
VITE_LEDGER_BASE_URL=http://localhost:8082
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=incentivepay
VITE_KEYCLOAK_CLIENT_ID=incentivepay-client

# DEV ONLY. A browser has no safe place to keep a shared secret - in a real
# deployment the dashboard would call through a backend-for-frontend that
# adds this signature server-side, or mutating write paths would be
# server-to-server only. See README "Known simplifications".
VITE_HMAC_SECRET=dev-only-shared-secret-change-me
